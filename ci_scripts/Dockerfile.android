# Prebuilt CI image for Android release builds.
#
# Everything the pipeline needs is baked in, so no SDK packages, NDK or Flutter
# have to be downloaded per job — the image is the toolchain cache.
#
# You normally never build this by hand: the ci_image job reads the version from
# .fvmrc and builds and pushes the image automatically whenever no image exists
# for that version yet. Bumping .fvmrc is all it takes to get a new one.
#
# Manual build, if ever needed:
#   docker build --platform linux/amd64 --build-arg FLUTTER_VERSION=3.38.2 \
#     -t <registry>/<path>/android-ci:3.38.2 -f ci_scripts/Dockerfile.android .
#
# Base is pinned to the amd64 digest: Flutter ships gen_snapshot (Android AOT)
# for x86_64 hosts only, so an arm64 image cannot produce release builds.
FROM ghcr.io/cirruslabs/android-sdk:35@sha256:54e4ef10f19c211052851736dfb783ee26935a089b06bb1f9019a311cdc38af0

# Keep in sync with .fvmrc — the pipeline verifies this at runtime and falls
# back to installing Flutter itself if the image is stale.
ARG FLUTTER_VERSION=3.38.2

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

# SDK components. Deliberately generous — plugins routinely pull in older
# platforms, and a fat image is cheaper than re-downloading on every job.
#
# Split across several RUN steps on purpose: it keeps individual layers small
# enough for registries that choke on multi-GB blob uploads. The NDK gets its
# own layer because it is by far the largest component.
RUN yes | sdkmanager --licenses > /dev/null

RUN sdkmanager --install \
      "platform-tools" \
      "platforms;android-36" \
      "platforms;android-35" \
    > /dev/null

RUN sdkmanager --install \
      "platforms;android-34" \
      "platforms;android-33" \
      "platforms;android-32" \
      "platforms;android-31" \
    > /dev/null

RUN sdkmanager --install \
      "build-tools;36.0.0" \
      "build-tools;35.0.0" \
      "build-tools;34.0.0" \
      "build-tools;33.0.1" \
    > /dev/null

RUN sdkmanager --install "ndk;28.2.13676358" > /dev/null

RUN sdkmanager --install "cmake;3.22.1" > /dev/null

# Flutter SDK, split from the engine artifacts for the same layer-size reason.
RUN git clone https://github.com/flutter/flutter.git --depth 1 -b "${FLUTTER_VERSION}" "${FLUTTER_HOME}" && \
    git config --global --add safe.directory "${FLUTTER_HOME}"

RUN flutter precache --android --no-ios --no-macos --no-linux --no-windows --no-web && \
    flutter --version

# Ruby + fastlane for the Play Store upload job.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ruby-full build-essential && \
    gem install fastlane -N --no-document && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN fastlane --version
